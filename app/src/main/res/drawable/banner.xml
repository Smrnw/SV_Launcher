<?xml version="1.0" encoding="utf-8"?>
<!-- 16:9 banner shown by other TV launchers: the monogram on graphite. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size
                android:width="320dp"
                android:height="180dp" />
            <solid android:color="@color/logo_tile" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/logo_mark"
        android:gravity="center" />
</layer-list>
