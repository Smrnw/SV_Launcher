<?xml version="1.0" encoding="utf-8"?>
<!-- 16:9 banner shown by other TV launchers: the monogram on graphite. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size
                android:width="320dp"
                android:height="180dp" />
            <solid android:color="@color/logo_tile" />
        </shape>
    </item>
    <!-- 320x180 banner, a 180x180 mark in the middle (insets work on API 21). -->
    <item
        android:drawable="@drawable/logo_mark"
        android:left="70dp"
        android:right="70dp" />
</layer-list>
