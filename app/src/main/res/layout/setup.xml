<?xml version="1.0" encoding="utf-8"?>
<!-- First-start wizard: one screen whose content changes from step to step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="170dp"
    android:paddingTop="32dp"
    android:paddingEnd="170dp"
    android:paddingBottom="32dp">

    <!-- The logo and the step counter share one line. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:id="@+id/setup_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/setup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/text"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/setup_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/setup_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/setup_back"
            style="@style/SetupButton"
            android:text="@string/setup_back" />

        <TextView
            android:id="@+id/setup_next"
            style="@style/SetupButton"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</LinearLayout>
