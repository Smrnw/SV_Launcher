<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row: optional icon, title with its state under it, optional arrow
     for rows that open a page of their own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="14dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/row_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            style="@style/RowTitle" />

        <TextView
            android:id="@+id/row_summary"
            style="@style/RowSummary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:alpha="0.6"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        android:tint="@color/row_content"
        android:visibility="gone" />
</LinearLayout>
